# .htaccess do hub Andrea Eboli — hospedagem cPanel/LiteSpeed (nuvemHospedagem)
#
# ⚠️ ESTE ARQUIVO É COPIADO PARA out/.htaccess PELO WORKFLOW DE DEPLOY.
# Ele precisa fazer parte do artefato enviado, e não ser posto à mão no
# servidor: o deploy sincroniza `out/` com `public_html` apagando o que sobra,
# então um .htaccess criado à mão seria removido no deploy seguinte e levaria
# embora a raiz, os redirects e a página 404 de uma vez.
#
# Não vale nada no GitHub Pages (que ignora .htaccess). É inofensivo lá.

# ----------------------------------------------------------------------
# Índice de diretório
# ----------------------------------------------------------------------
# Cada rota do export é um diretório com index.html dentro (efeito do
# `trailingSlash: true` no next.config.ts).
#
# 🔴 `index.php` PRECISA estar na lista, e o motivo foi aprendido derrubando um
# site de verdade. Este .htaccess vive na raiz de public_html e é HERDADO pelos
# subdiretórios — inclusive pelos document roots dos outros dois sites da conta
# (edroficinadesolucoes.com e form.andreaeboli.com) e por /wp-admin/. Com
# `DirectoryIndex index.html` sozinho, todo diretório que só tem index.php
# passou a responder 403: o edroficinadesolucoes.com saiu do ar e o wp-admin
# ficou inacessível.
#
# `index.html` vem primeiro, então nas rotas do hub nada muda. E a raiz do
# domínio não volta para o WordPress porque a RewriteRule mais abaixo
# redireciona "/" para /pt/ antes de o DirectoryIndex ser consultado.
DirectoryIndex index.html index.php

# `-Indexes`: 577 diretórios do export NÃO têm index.html (são pastas de
# payload do Next e de assets). Sem isto, /brand/ e /confraria/ viram listagem
# pública de arquivos.
#
# `-MultiViews`: cada rota tem `index.html` e `index.txt` lado a lado. Com
# MultiViews ligado o Apache negocia a extensão e /pt/sobre poderia servir o
# .txt em vez do .html.
Options -Indexes -MultiViews

# Mantém o 301 automático de /pt/sobre para /pt/sobre/, que é a URL canônica
# que o HTML declara.
DirectorySlash On

# ----------------------------------------------------------------------
# Página de erro
# ----------------------------------------------------------------------
# O export gera out/404.html. Sem esta linha o visitante recebe a tela de erro
# crua do LiteSpeed em vez da página 404 do site.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --------------------------------------------------------------------
  # Renovação do SSL — PRIMEIRA REGRA, antes de qualquer outra
  # --------------------------------------------------------------------
  # O AutoSSL do cPanel valida o domínio buscando um arquivo em
  # /.well-known/acme-challenge/. Se qualquer regra abaixo interceptar esse
  # caminho, o certificado deixa de renovar e o site cai em aviso de segurança
  # na data da expiração. Esta regra encerra o processamento para ele.
  RewriteRule ^\.well-known/ - [L]

  # --------------------------------------------------------------------
  # HTTPS
  # --------------------------------------------------------------------
  # O SSL já está ativo no domínio, mas a força de HTTPS morava no .htaccess do
  # WordPress e sai junto com ele. Sem isto, http:// passa a servir o site em
  # texto claro.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --------------------------------------------------------------------
  # Markdown por negociação de conteúdo (acceptmarkdown.com)
  # --------------------------------------------------------------------
  # Quem pedir `Accept: text/markdown` recebe o `index.md` que o
  # `gera-artefatos-agentes.mjs` escreveu ao lado de cada `index.html`: a mesma
  # página sem menu, rodapé nem script. Navegador nenhum manda esse tipo, então
  # gente continua recebendo HTML.
  #
  # ⚠️ O padrão casa SÓ com as rotas de conteúdo (/pt/, /en/, /es/). Deixar
  # solto pegaria /admin/ — o painel é uma SPA e passaria a servir markdown
  # para a própria requisição dela.
  #
  # Só reescreve se o arquivo existir de verdade: numa rota sem `.md` a
  # requisição segue para o HTML em vez de virar 404.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1index.md -f
  RewriteRule ^((?:pt|en|es)/(?:[^?]*/)?)$ /$1index.md [L]

  # 406 quando o cliente exige um tipo que esta rota não sabe produzir — é o
  # 3º critério do acceptmarkdown.com. As negações cobrem quem aceita qualquer
  # coisa (`*/*`, `text/*`) e quem não mandou `Accept` nenhum: esses continuam
  # recebendo HTML. Restrito às rotas de conteúdo pelo mesmo motivo da regra
  # acima.
  RewriteCond %{HTTP_ACCEPT} !^$
  RewriteCond %{HTTP_ACCEPT} !\*/\*
  RewriteCond %{HTTP_ACCEPT} !text/\*
  RewriteCond %{HTTP_ACCEPT} !text/html [NC]
  RewriteCond %{HTTP_ACCEPT} !text/markdown [NC]
  RewriteCond %{HTTP_ACCEPT} !application/xhtml [NC]
  RewriteRule ^((?:pt|en|es)/(?:[^?]*/)?)$ - [R=406,L]

  # --------------------------------------------------------------------
  # O painel (Sanity Studio) em /admin
  # --------------------------------------------------------------------
  # O painel é uma SPA: UM index.html que desenha todas as telas no navegador.
  # As URLs internas dele (/admin/structure/article;abc123, /admin/vision, …)
  # NÃO existem como arquivo no servidor — sem a regra abaixo, recarregar a
  # página com F5 dentro do painel devolve 404, e é a primeira coisa que
  # alguém faz.
  #
  # As duas condições de arquivo/diretório vêm antes de propósito: enquanto o
  # caminho existir de verdade (o index.html, os bundles de /admin/static/),
  # o servidor entrega o arquivo e nada é reescrito.
  RewriteCond %{REQUEST_URI} ^/admin(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /admin/index.html [L]

  # Atalho para quem digitar o painel com o idioma na frente. O painel é um só
  # e tem idioma próprio, então não faz parte do /pt /en /es do site.
  RewriteRule ^(pt|en|es)/admin/?$ /admin/ [R=301,L]

  # --------------------------------------------------------------------
  # Raiz do domínio → português
  # --------------------------------------------------------------------
  # O site não tem página na raiz: o conteúdo vive em /pt, /en e /es.
  #
  # ⚠️ NÃO usar `Redirect 301 / /pt/`: o prefixo "/" casa também com "/pt/", e
  # o resultado é /pt/pt/pt/... até o navegador desistir. O ^/?$ abaixo casa
  # exclusivamente a raiz.
  RewriteRule ^/?$ /pt/ [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# Arquivos que não devem ser servidos
# ----------------------------------------------------------------------
# A action de FTP guarda o estado da sincronização incremental DENTRO do
# diretório publicado. Sem esta regra, qualquer pessoa baixa esse arquivo e
# recebe a árvore completa do site, com todos os caminhos e hashes.
#
# São dois: `.deploy-sync-state.json` (o site, na raiz) e
# `.deploy-painel-state.json` (o painel, em /admin). O padrão cobre os dois e
# o próximo que aparecer.
<FilesMatch "^\.deploy-[a-z-]+-state\.json$">
  Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Cache
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Os arquivos de /_next/static/ têm hash no nome: quando o conteúdo muda, o
  # nome muda. Podem ser cacheados para sempre.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" LONG_CACHE=1
    # Os bundles do painel também têm hash no nome (pane2-RcSanCwq.js).
    # Só .js e .css: os favicons de /admin/static/ não têm hash e caem na
    # regra de imagens mais abaixo.
    SetEnvIf Request_URI "^/admin/static/.+\.(js|css)$" LONG_CACHE=1
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  # O HTML NÃO pode ser cacheado de forma longa. O conteúdo vem do Sanity no
  # momento do build: quando a Andrea publica no Studio e o site é
  # republicado, o mesmo caminho passa a ter conteúdo novo. Com cache longo o
  # visitante continuaria vendo a versão antiga.
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # `Vary: Accept` — 2º critério do acceptmarkdown.com. A MESMA URL responde
  # HTML ou markdown conforme o `Accept`, então quem cacheia precisa saber que
  # o cabeçalho faz parte da chave. Sem isto, o primeiro a entrar no cache é
  # servido a todo mundo: agente recebendo HTML, ou pior, pessoa recebendo
  # markdown cru.
  #
  # `append` e não `merge`: `merge` é mais recente no mod_headers e não vale
  # arriscar o .htaccess inteiro em 500 por uma diretiva não reconhecida. Nada
  # mais neste arquivo define `Vary`, então não há duplicata a evitar.
  <FilesMatch "\.(html|md)$">
    Header append Vary "Accept"
  </FilesMatch>

  # As fontes e imagens de public/ não têm hash no nome, então cache moderado.
  <FilesMatch "\.(woff2?|ttf|eot|otf|jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Tipos de conteúdo
# ----------------------------------------------------------------------
# Defensivo: no LiteSpeed testado nenhum destes foi obrigatório, mas declarar
# custa nada e um Content-Type errado em .woff2 ou .webp é o tipo de falha que
# só aparece no navegador de outra pessoa.
<IfModule mod_mime.c>
  # O markdown servido por negociação. Sem o charset, acento sai quebrado em
  # cliente que assume Latin-1.
  AddType text/markdown               .md
  AddCharset UTF-8                    .md

  AddType image/webp                  .webp
  AddType image/avif                  .avif
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType font/woff                   .woff
  AddType application/manifest+json   .webmanifest
  AddCharset UTF-8                    .html .txt .xml .json .css .js
</IfModule>

# ----------------------------------------------------------------------
# Compressão
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml application/rss+xml image/svg+xml text/markdown
</IfModule>
